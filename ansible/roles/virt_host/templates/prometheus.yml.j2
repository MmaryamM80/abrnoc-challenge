global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    site: abrnoc-demo
rule_files:
  - /etc/prometheus/virt-host-alerts.yml
alerting:
  alertmanagers:
    - static_configs:
        - targets: ['127.0.0.1:9093']
scrape_configs:
  - job_name: node
    static_configs:
      - targets: ['127.0.0.1:9100']
        labels: {host: '{{ ansible_facts["hostname"] }}'}
  - job_name: libvirt
    static_configs:
      - targets: ['127.0.0.1:9177']
        labels: {host: '{{ ansible_facts["hostname"] }}'}
