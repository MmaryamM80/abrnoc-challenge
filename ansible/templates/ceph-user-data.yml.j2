#cloud-config
hostname: ceph1
manage_etc_hosts: true
ssh_pwauth: false
disable_root: true
users:
  - default
  - name: ansible
    gecos: Lab administrator
    groups: [sudo]
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - {{ lookup('file', playbook_dir + '/../keys/admin.pub') | trim }}
package_update: true
packages:
  - qemu-guest-agent
runcmd:
  - [ systemctl, enable, --now, qemu-guest-agent ]
